	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@vitejs/plugin-vue": "^6.0.10",
		"@vue/test-utils": "^2.5.1",
		"electron": "^45.2.3",
		"electron-builder": "^26.18.0",
		"eslint": "^10.14.0",
		"eslint-plugin-vue": "^10.12.0",
		"globals": "^17.14.0",
		"jsdom": "^31.0.0",
